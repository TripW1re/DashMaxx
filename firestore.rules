rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User data — only the authenticated user can access their own
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /shifts/{shiftId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /predictions/{zoneId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // Only Cloud Functions write predictions
      }
    }

    // Zone data — public read, admin write
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // Social feed — authenticated users read/write their own posts;
    // anyone signed in may tip (updates limited to the `tips` field only).
    match /social/posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 500
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 40
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 8;
      allow update: if request.auth != null
        && (request.resource.data.uid == resource.data.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tips']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Leaderboard profiles — read all, write only your own
    match /social/profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 8
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 200;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Meetups — authenticated read; RSVPs are per-user subcollection docs
    match /meetups/{meetupId} {
      allow read: if request.auth != null;
      match /rsvps/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
