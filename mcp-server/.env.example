# DoorDash Auth Token
# Get this by logging into dasher.doordash.com → DevTools → Network →
# find api.doordash.com request → copy Authorization: Bearer <token>
DD_AUTH_TOKEN=

# Server config
PORT=3100
SYNC_INTERVAL_MINUTES=5

# API key required to call all endpoints except /health and /.
# The DashMaxx app sends this as the `x-api-key` header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave empty to disable auth (dev only).
DD_API_KEY=

# Firebase (optional - in-memory cache used if not set)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
